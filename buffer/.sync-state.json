  [1;37m├── buffer/              ← 沟通桥梁（已有，规则二）[0m
  [1;37m├── shared/              ← 新增记忆区（规则三）[0m
  [1;37m│   ├── MEMORY.md        ← 我们的共同记忆[0m
  [1;37m│   ├── IDENTITY.md      ← 共同身份[0m
  [1;37m│   └── SOUL.md          ← 共同灵魂[0m
  [1;37m├── scripts/             ← 各自脚本（各自私有，改完告知）[0m
  [1;37m└── ...[0m
